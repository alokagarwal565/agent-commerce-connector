# WooCommerce API credentials (generate at WooCommerce > Settings > Advanced > REST API)
WOOCOMMERCE_STORE_URL=https://example-store.test
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# Optional tuning
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
